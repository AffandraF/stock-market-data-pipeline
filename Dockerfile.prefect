# Dockerfile.prefect
FROM python:3.12-slim-bullseye

WORKDIR /opt/prefect

RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-17-jdk \
    curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH="${JAVA_HOME}/bin:${PATH}"
ENV PYTHONUNBUFFERED=1

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# COPY ./src /opt/prefect/flows

# Startup script
RUN echo '#!/bin/bash\n\
echo "Starting Prefect server..."\n\
prefect server start --host 0.0.0.0 &\n\
SERVER_PID=$!\n\
\n\
echo "Waiting for Prefect server to be ready..."\n\
until curl -f http://localhost:4200/api/health > /dev/null 2>&1; do\n\
  echo "Server not ready yet, waiting..."\n\
  sleep 5\n\
done\n\
\n\
echo "Server is ready! Creating work pool..."\n\
export PREFECT_API_URL=http://localhost:4200/api\n\
prefect work-pool create --type process "default-agent-pool" 2>/dev/null || echo "Work pool already exists or creation failed"\n\
\n\
echo "Starting worker..."\n\
prefect worker start --pool "default-agent-pool" &\n\
WORKER_PID=$!\n\
\n\
echo "Both server and worker are running"\n\
wait $SERVER_PID $WORKER_PID\n\
' > /opt/prefect/start.sh && chmod +x /opt/prefect/start.sh

# Add alias-like script for running flows
RUN echo '#!/bin/bash\n\
python /opt/prefect/src/flows.py "$@"\n\
' > /usr/local/bin/runflows && chmod +x /usr/local/bin/runflows

CMD ["/opt/prefect/start.sh"]